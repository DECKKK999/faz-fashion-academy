DATABASE_URL="postgresql://USER@localhost:5432/faz_academy_development?schema=public"
JWT_SECRET="ganti-dengan-secret-acak-yang-kuat"
PORT=4000
CLIENT_ORIGIN="http://localhost:8080"
JWT_EXPIRES_DAYS=7
COOKIE_SECURE="false"

# ===== Google Sheets sync untuk certificate_codes (opsional) =====
# Kosongkan ketiganya untuk menonaktifkan sync (aman, tidak ada fitur lain yang terpengaruh).
# GOOGLE_SERVICE_ACCOUNT_JSON: isi mentah file JSON service account (satu baris, bukan path file).
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"...", ...}'
# CERTIFICATE_SHEET_ID: ID dari URL sheet-nya, https://docs.google.com/spreadsheets/d/ID_INI/edit
# CERTIFICATE_SHEET_TAB: nama tab/sheet di dalam file itu (default "Data Sertifikat Kelas 1.0")

# ===== DOKU Checkout (opsional) =====
# Kosongkan ketiganya untuk memakai transfer manual saja (aman, tidak ada fitur lain yang terpengaruh).
# DOKU_CLIENT_ID / DOKU_SECRET_KEY: dari dashboard DOKU (Settings > API Keys).
# DOKU_CLIENT_ID="BRN-xxxx-xxxxxxxxxxxx"
# DOKU_SECRET_KEY="SK-xxxxxxxxxxxxxxxxxxxx"
# DOKU_MODE: "sandbox" (default) atau "production"
# DOKU_MODE="sandbox"
